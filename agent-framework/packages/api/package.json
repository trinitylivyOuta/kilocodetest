{
  "name": "@agent-framework/api",
  "version": "0.1.0",
  "description": "LLM provider abstraction for Agent Framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-framework/types": "workspace:*",
    "@anthropic-ai/sdk": "^0.51.0",
    "openai": "^5.12.2"
  },
  "keywords": [
    "llm",
    "api",
    "anthropic",
    "openai",
    "provider"
  ],
  "license": "MIT"
}
