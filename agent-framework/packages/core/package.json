{
  "name": "@agent-framework/core",
  "version": "0.1.0",
  "description": "Core agent execution engine",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agent-framework/types": "workspace:*",
    "@agent-framework/api": "workspace:*",
    "@agent-framework/tools": "workspace:*",
    "eventemitter3": "^5.0.1"
  },
  "keywords": [
    "agent",
    "ai",
    "core",
    "llm"
  ],
  "license": "MIT"
}
