{
  "name": "agent-framework",
  "version": "0.1.0",
  "description": "Reusable AI agent framework extracted from Kilocode - runs in VSCode, CLI, and Node.js",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "clean": "pnpm -r clean",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"packages/**/*.{ts,json,md}\"",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prettier": "^3.4.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.3"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "anthropic",
    "openai",
    "framework",
    "automation"
  ],
  "author": "Kilocode Framework Contributors",
  "license": "MIT"
}
